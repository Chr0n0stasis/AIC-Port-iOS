DEFINENDEF 1=
// 1: Fatalシーンからの再生
_from_fatal=$1

PIC_HIDE_ALL	'' 
<NOLOAD>

START_LETTERBOX
HIDE_LETTERBOX
START_GMAIN
HIDE_STATUS

DENY_SKIP
LOAD_BGM BGM_gameover_totitle


IF '!'$_from_fatal {
    _shiftpos=-300
    SHOW_BLURSC 1
    START_BLURSC_TO_BEHIND
    UIP_EVENT_SETFADE %CURRENT STONEOVER 1 1
    UIP_REPOSIT -50 60 1.9 -40 1
    UI_ENABLE
} ELSE {
    UI_DISABLE 1
    _shiftpos=~-schh_px*0.82
}
TL 20 REPLACE_BGM 1 1
TL 30 TITLECALL Telop_gameover 64
TL 30 TITLECALL_FRONT
TL 30 TITLECALL_SETTING 0 50 50 0 1 1
TL 30 TITLE_POS_SHIFT 0 $_shiftpos
TL 160 TITLECALL_SETTING 0 50 50 0 0 1
WAIT 120

DOTL
ALLOW_SKIP

WAIT_BUTTON
DENY_SKIP
TITLECALL_HIDE

PIC_FILL	&99 DARK
PIC_FADEIN &99 70
WAIT 80
UIP_EVENT_SETFADE 0
UIP_REPOSIT 0 0 1 0 
IF $_from_fatal {
    FATAL_DISPOSE
}
GAME_QUIT_TO_TITLE
