#SND_LOAD m2d_house
#< % >
#MS '>>[Ev_hotel 0,0 <<0.02] P[walk] '
TL 65 #MS '= P[stand_ev~]'
WAIT 40
LP_ACTIVATE_TO_CHIP window Ev_hotel
TL 60 LP_DEACTIVATE_TO_CHIP window Ev_hotel
SHOW_BLURSC

UI_HOTEL caravan
HALF_BGM 1
LABEL _HOTEL_AGAIN
DOTL
IF $_result'==1' {
    // 宿泊を行った
    HIDENOEL 1
    PIC_FILL	&3 DARK
    PIC_FADEIN	&3 50
    STOP_BGM	150 0
    DENY_SKIP
    HALF_BGM 0
    LOAD_BGM	BGM_inn
    WAIT 65
    REPLACE_BGM 1 1 0
    WAIT 60
    ALLOW_SKIP
    WAIT_BUTTON 400
    WAIT 20
    DENY_SKIP
    HALF_BGM 1
    TL 40 REPLACE_BGM 100 100 0
    UI_INN_SLEEP_NIGHTCON_PROGRESS
    ALLOW_M2D_DRAW_BEHIND_EVENT
    STOREFLUSH
    MGM_FISH_FEED_FLUSH
    WAIT 5
    SHOW_BLURSC
    DENY_M2D_DRAW_BEHIND_EVENT
    PIC_FADEOUT	&3 80
    WEATHER_PROGRESS
    WAIT_FN REELMNG
    WAIT_FN NIGHTCON
    ALLOW_SKIP
    UI_INN_SLEEP_EXECUTE
    
    GOTO _HOTEL_AGAIN
}
WAIT 20
HIDENOEL 0
LP_ACTIVATE_TO_CHIP window Ev_hotel
HIDE_BLURSC
#MS '>>[Ev_hotel -40,0 <<0.02]'
WAIT 60
